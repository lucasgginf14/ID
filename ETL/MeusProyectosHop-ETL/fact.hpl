<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>fact</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>UPDATE_DATE</name>
        <default_value>'2025-01-02'</default_value>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2019/11/22 10:31:09.195</created_date>
    <modified_user>-</modified_user>
    <modified_date>2019/11/22 10:31:09.195</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Table input</from>
      <to>Database lookup cruise</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Database lookup cruise</from>
      <to>Database lookup voyage</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Database lookup voyage</from>
      <to>Database lookup date</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Database lookup date</from>
      <to>Table output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Database lookup cruise</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <connection>etl_datamart</connection>
    <lookup>
      <eat_row_on_failure>Y</eat_row_on_failure>
      <fail_on_multiple>N</fail_on_multiple>
      <key>
        <condition>=</condition>
        <field>id_cruise</field>
        <name>id_cruise</name>
      </key>
      <schema>"public"</schema>
      <table>dim_cruise</table>
      <value>
        <name>id_cruise</name>
        <rename>id_cruise_DL</rename>
        <trim_type>both</trim_type>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Database lookup date</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <connection>etl_datamart</connection>
    <lookup>
      <eat_row_on_failure>Y</eat_row_on_failure>
      <fail_on_multiple>N</fail_on_multiple>
      <key>
        <condition>=</condition>
        <field>id_date</field>
        <name>id_date</name>
      </key>
      <schema>"public"</schema>
      <table>dim_date</table>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Database lookup voyage</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <connection>etl_datamart</connection>
    <lookup>
      <eat_row_on_failure>Y</eat_row_on_failure>
      <fail_on_multiple>N</fail_on_multiple>
      <key>
        <condition>=</condition>
        <field>id_voyage</field>
        <name>id_voyage</name>
      </key>
      <schema>public</schema>
      <table>dim_voyage</table>
      <value>
        <name>id_voyage</name>
        <rename>id_voyage_DL</rename>
        <trim_type>both</trim_type>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>etl_operacional</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
    b.cruise AS id_cruise,
    b.voyage AS id_voyage,
    TO_CHAR(b.date, 'DDMMYYYY')::numeric AS id_date,
    COUNT(DISTINCT b.id) AS total_bookings,
    SUM(b.amount) AS total_amount,
    COUNT(pb.passenger) AS total_passengers
FROM
    public.booking b
JOIN
    public.passenger_booking pb ON b.id = pb.booking
WHERE
    b.date = ${UPDATE_DATE}
GROUP BY
    b.cruise,
    b.voyage,
    b.date</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Table output</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>etl_datamart</connection>
    <fields>
      <field>
        <column_name>id_cruise</column_name>
        <stream_name>id_cruise</stream_name>
      </field>
      <field>
        <column_name>id_date</column_name>
        <stream_name>id_date</stream_name>
      </field>
      <field>
        <column_name>id_voyage</column_name>
        <stream_name>id_voyage</stream_name>
      </field>
      <field>
        <column_name>total_bookings</column_name>
        <stream_name>total_bookings</stream_name>
      </field>
      <field>
        <column_name>total_passengers</column_name>
        <stream_name>total_passengers</stream_name>
      </field>
      <field>
        <column_name>total_amount</column_name>
        <stream_name>total_amount</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>"public"</schema>
    <specify_fields>Y</specify_fields>
    <table>fact_bookings</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>1024</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes>
    <group>
      <name>debug_plugin</name>
    </group>
  </attributes>
</pipeline>
