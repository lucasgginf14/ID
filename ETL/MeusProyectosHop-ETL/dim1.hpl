      </value>
      <value>
        <name>init_date</name>
        <rename>init_date</rename>
      </value>
      <value>
        <name>end_date</name>
        <rename>end_date</rename>
      </value>
      <value>
        <name>duration</name>
        <rename>duration</rename>
      </value>
      <value>
        <name>price</name>
        <rename>price</rename>
      </value>
    </lookup>
    <skip_lookup>N</skip_lookup>
